{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @ffmpeg-hls-vod-transcoder/web build",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/shared/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/infra/railway/web.railway.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @ffmpeg-hls-vod-transcoder/web start -- --hostname 0.0.0.0 --port $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
