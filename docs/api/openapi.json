      "LadderPreset": {
        "description": "Finite quality-ladder presets (a *ceiling*, not a single rendition).\n\nA preset expands into every rung at or below its height, so \"720p\" yields\n360p + 720p and \"1080p\" yields 360p + 720p + 1080p. The Ingest and\nRe-transcode forms present these as a `Select` (finite options).",
        "enum": [
          "360p",
          "720p",
          "1080p"
        ],
        "title": "LadderPreset",
        "type": "string"
      },
